        GSHEET_MACRO["Google Sheets\nMacro Tab"]
    end

    subgraph PHASE1["Phase 01 — Scrape"]
        SCRAPER["main.py\nSelenium + feedparser\nParallel 10 threads"]
        PDF_SCRAPER["hsx_insider_scraper.py\nfetch & filter disclosures"]
        PDF_PREP["hsx_prepare_pdfs.py\ndownload PDF → PNG images"]
        AGENT_EXTRACT["format_hsx_trading_news.py\nLLM agent → structured JSON"]
    end

    subgraph PHASE2["Phase 02 — Curate"]
        UPLOAD_SHEETS["upload-to-sheets.js\nPlaywright CDP → Chrome"]
        HUMAN["👤 Human Editor\nmarks TAKE, writes Macro"]
        READ_SHEET["get_sheet_tab.js\nread-macro-sheet.js"]
    end

    subgraph PHASE3["Phase 03 — Summarize"]
        FETCH["fetch_full_articles.py\nfull text fetch"]
        CHUNK["prepare_chunks.py\nsplit by token budget"]
        LLM_SUMM["Claude Agent\n/summarize-news skill\nbilingual EN/VN"]
        COMBINE["combine_chunks.py\nmerge + macro + trading → 4 JSONs"]
        DEDUP["dedup_engine.py\ndeduplicate_reports.py\nsemantic dedup"]
        VALIDATE["harness.py\nschema + word-count validator"]
        JSON_OUT["reports/{session}/data/\ncorporate.json / macro.json\ntrading.json / epo.json"]
    end

    subgraph PHASE4["Phase 04 — Publish"]
        HTML_GEN["generate_html_report.py\nA4 fixed layout + brand CSS"]
        PDF_GEN["generate_pdf_report.py\nPlaywright → PDF"]
        DOCX_GEN["generate_docx_report.py"]
        BENCHMARK["benchmark_html_against_pdf.py\nvisual regression guard"]
        HEYZINE["run-upload.js\nPlaywright → Heyzine flipbook"]
    end

    subgraph OUTPUTS["📤 Deliverables"]
        PDF_OUT["PDF Report\nEN + VN"]
        DOCX_OUT["DOCX Report"]
        FLIPBOOK["Heyzine Flipbook\nshare link"]
    end

    RSS --> SCRAPER
    HSX --> PDF_SCRAPER
    PDF_SCRAPER --> PDF_PREP --> AGENT_EXTRACT
    SCRAPER --> UPLOAD_SHEETS
    AGENT_EXTRACT --> UPLOAD_SHEETS
    UPLOAD_SHEETS --> HUMAN --> READ_SHEET
    GSHEET_MACRO --> READ_SHEET

    READ_SHEET --> FETCH --> CHUNK --> LLM_SUMM --> COMBINE --> VALIDATE --> DEDUP --> JSON_OUT

    JSON_OUT --> HTML_GEN --> BENCHMARK
    HTML_GEN --> PDF_GEN --> PDF_OUT
    HTML_GEN --> DOCX_GEN --> DOCX_OUT
    PDF_OUT --> HEYZINE --> FLIPBOOK

