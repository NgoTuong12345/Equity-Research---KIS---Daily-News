flowchart LR
    classDef llm fill:#e1e8f7,stroke:#5692ce,stroke-width:2px,color:#000
    classDef tool fill:#f9f9f9,stroke:#999,stroke-width:1px,stroke-dasharray: 3 3
    classDef human fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#000
    classDef output fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#000

    A["Scheduled Trigger<br/>(run-morning.bat / run-afternoon.bat)"] --> B["Scraper Module"]

    subgraph "Phase 1: Discovery & Collection"
        B --> B1["Tool: RSS / Website Fetchers"]:::tool
        B --> B2["Tool: FireAnt Selenium Scraper"]:::tool
        B --> B3["Tool: HSX Insider Scraper"]:::tool
        
        B1 & B2 --> C["Raw News Data (JSON)"]
        B3 --> D["HSX Disclosures (PDF)"]
    end

    subgraph "Phase 2: LLM Information Extraction"
        D --> D1["Tool: hsx_prepare_pdfs.py<br/>(Render PDF to Images)"]:::tool
        D1 --> D2["Subagent: hsx_agent_extractor"]:::llm
        D2 -- "Observe: Images & Text" --> D3["Tool: emit_json"]:::tool
        D3 --> D4["Extracted Trading Txns (JSON)"]
        
        D4 --> D5["Tool: format_hsx_trading_news.py<br/>(--prepare)"]:::tool
        D5 --> D6["Subagent: trading_formatter<br/>(Translate & Clean)"]:::llm
        D6 --> D7["Tool: format_hsx_trading_news.py<br/>(--merge)"]:::tool
        D7 --> C
    end

    subgraph "Phase 3: Filtering & Human-in-the-Loop"
        C --> E["Tool: Deduplication & Tagging"]:::tool
        E --> F["Tool: upload-to-sheets.js"]:::tool
        F --> G["Google Sheets Session Tab"]
        
        G --> H["Human Reviewer<br/>(Marks TAKE rows & updates Macro)"]:::human
    end

    subgraph "Phase 4: Deep Content Processing"
        H --> I["Tool: generate-report.js<br/>(Reads Sheet)"]:::tool
        I --> J["Tool: fetch_full_articles.py"]:::tool
        
        J --> K["Subagent: summarize_news<br/>(KIS Style Guide Skill)"]:::llm
        K -- "Observe: Raw Articles" --> K1["LLM Actions:<br/>Summarize, Translate, Classify"]:::llm
        K1 --> L["Draft Summaries (JSON)"]
    end

    subgraph "Phase 5: Refinement & Validation"
        L --> M["Tool: apply_news_title_rules.py<br/>(--prepare)"]:::tool
        M --> N["Subagent: title_generator<br/>(Enforces strict limits & style)"]:::llm
        N -- "Observe: Categories & Summaries" --> O["LLM Action: Standardize Titles"]:::llm
        O --> P["Tool: apply_news_title_rules.py<br/>(--merge)"]:::tool
        P --> Q["Tool: validate_summary_data.py"]:::tool
    end

    subgraph "Phase 6: Publishing & Delivery"
        Q --> R1["Tool: generate_html_report.py"]:::tool
        Q --> R2["Tool: generate_pdf_report.py<br/>(Playwright Render)"]:::tool
        Q --> R3["Tool: generate_docx_report.py"]:::tool
        
        R1 & R2 --> S["Tool: benchmark_html_against_pdf.py<br/>(Layout Checks)"]:::tool
        
        S --> T["Publishing Automation"]
        R3 --> T
        
        T --> U["Tool: upload-to-heyzine.js<br/>(Chrome CDP Automator)"]:::tool
        U --> V["Final Artifacts<br/>(HTML, PDF, DOCX, Flipbook URLs)"]:::output
    end
